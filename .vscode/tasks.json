// See https://go.microsoft.com/fwlink/?LinkId=733558
// for the documentation about the `tasks.json` format
{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Extension in Background",
      "group": "build",
      "type": "shell",
      "command": "mise exec -- pnpm run watch",
      "options": {
        "cwd": "${workspaceFolder}/editors/vscode/"
      },
      "problemMatcher": {
        "base": "$tsc-watch",
        "fileLocation": ["relative", "${workspaceFolder}/editors/vscode/"]
      },
      "isBackground": true
    },
    {
      "label": "pnpm install (Extension)",
      "type": "shell",
      "command": "mise exec -- pnpm install",
      "options": {
        "cwd": "${workspaceFolder}/editors/vscode/"
      },
      "problemMatcher": []
    },
    {
      "label": "Build Extension",
      "group": "build",
      "type": "shell",
      "command": "mise exec -- pnpm run build",
      "options": {
        "cwd": "${workspaceFolder}/editors/vscode/"
      },
      "dependsOn": ["pnpm install (Extension)"],
      "problemMatcher": {
        "base": "$tsc",
        "fileLocation": ["relative", "${workspaceFolder}/editors/vscode/"]
      }
    },
    {
      "label": "Build CLI",
      "group": "build",
      "type": "shell",
      "command": "mise exec -- cargo build --package tombi-cli",
      "problemMatcher": "$rustc"
    },
    {
      "label": "Build CLI (Release)",
      "group": "build",
      "type": "shell",
      "command": "mise exec -- cargo build --release --package tombi-cli",
      "problemMatcher": "$rustc"
    },
    {
      "label": "Pretest",
      "group": "build",
      "isBackground": false,
      "type": "shell",
      "command": "mise exec -- pnpm run pretest",
      "options": {
        "cwd": "${workspaceFolder}/editors/vscode/"
      },
      "problemMatcher": {
        "base": "$tsc",
        "fileLocation": ["relative", "${workspaceFolder}/editors/vscode/"]
      }
    },
    {
      "label": "Build CLI and Extension",
      "dependsOn": ["Build CLI", "Build Extension"],
      "problemMatcher": "$rustc"
    },
    {
      "label": "Build CLI (Release) and Extension",
      "dependsOn": ["Build CLI (Release)", "Build Extension"],
      "problemMatcher": "$rustc"
    }
  ]
}
